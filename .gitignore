# Виртуальное окружение
.venv/
venv/
ENV/

# Кеш Python
__pycache__/
*.py[cod]
*$py.class

# База данных SQLite (если используется для локальной разработки)
db.sqlite3

# Файлы настроек среды и секретные ключи
.env
*.env

# Медиа-файлы (загруженные пользователями картинки, видео из папки media/)
media/

# Папка статики, если она генерируется автоматически (или файлы staticfiles)
staticfiles/

# Системные файлы и IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# Логи
*.log